{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "tingdao",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": [
      "program-windows/app.py",
      "program-windows/index.html",
      "program-windows/whisper_worker.py",
      "program-windows/whisper_worker_windows.py",
      "program-windows/sounds/",
      "program-windows/assets/",
      "program-windows/ffmpeg/"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "installer/branding.nsh"
      }
    }
  }
}
